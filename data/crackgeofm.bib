@article{KYEM2026107190,
title = {Multi-task crack foundation model for engineering-reliable crack representation and topology preservation in civil infrastructure},
journal = {Automation in Construction},
volume = {191},
pages = {107190},
year = {2026},
issn = {0926-5805},
doi = {https://doi.org/10.1016/j.autcon.2026.107190},
url = {https://www.sciencedirect.com/science/article/pii/S0926580526004310},
author = {Blessing Agyei Kyem and Joshua Kofi Asamoah and Eugene Denteh and Armstrong Aboah},
keywords = {Crack segmentation, Foundation model, Multi-task learning, Topology preservation, Uncertainty estimation, Cross-domain transfer, Infrastructure inspection},
abstract = {Reliable crack assessment requires not only accurate pixel-level masks but also connected crack geometry and confidence estimates that remain stable under domain shift. However, existing segmentation models can achieve high overlap scores while fragmenting cracks, missing fine branches, and providing no calibrated uncertainty. To address this gap, this paper proposes CrackGeoFM, a multi-task framework that combines a frozen visual foundation backbone with crack-specific adaptation for mask prediction, skeleton reconstruction, and uncertainty estimation. It integrates a Frequency-Guided Crack Enhancement Module (FCEM) to enhance high-frequency crack cues, a Crack-Domain Feature Adaptation Module (CFAM) to adapt frozen backbone features to crack-domain patterns, and a Structure-Aware Multi-Task Decoder (SMTD) to jointly decode masks, skeletons, and uncertainty. Across 20 crack datasets, CrackGeoFM achieves state-of-the-art segmentation, improved topology preservation, calibrated uncertainty, and effective few-shot adaptation with five labeled images. These results establish a multi-task representation foundation for reliable, generalizable, and engineering-oriented crack analysis in infrastructure assessment.}
}